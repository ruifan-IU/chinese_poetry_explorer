// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dynasty {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  poets     Poet[]
  poems     Poem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Poet {
  id           Int      @id @default(autoincrement())
  stars       Int      @default(0)
  name         String   @unique
  image       String?
  introduction   String?
  dynastyId    Int?
  dynasty      Dynasty? @relation(fields: [dynastyId], references: [id])
  poems        Poem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dynastyId])
  @@index([name])
  @@index([stars])
}

enum PoemType {
  shi
  ci
  wen
}

model Poem {
  id            Int                @id @default(autoincrement())
  title         String
  stars         Int                @default(0)
  content       String
  contentHash   String             @unique
  type          PoemType           @default(shi)
  poetId        Int
  dynastyId     Int
  poet          Poet               @relation(fields: [poetId], references: [id])
  dynasty       Dynasty            @relation(fields: [dynastyId], references: [id])
  tags          Tag[]
  annotations PoemAnnotation[]
  favorites     UserFavorite[]
  memorizations UserMemorization[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([title])
  @@index([poetId])
  @@index([dynastyId])
  @@index([stars])
  @@index([type])
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  poems Poem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AnnotationType {
  TRANSLATION
  COMMENTARY
  BACKGROUND
}

enum AnnotationOrigin {
  IMPORTED
  HUMAN
  GENERATED
}

model PoemAnnotation {
  id        Int              @id @default(autoincrement())
  poemId    Int
  type      AnnotationType
  content   String
  origin    AnnotationOrigin
  poem      Poem             @relation(fields: [poemId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([poemId, type])
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  name              String?
  password          String
  emailVerified     Boolean            @default(false)
  verificationToken String?            @unique
  tokenExpiry       DateTime?
  favorites         UserFavorite[]
  memorizations     UserMemorization[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([email])
}

model UserFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  poemId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poem      Poem     @relation(fields: [poemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, poemId])
  @@index([userId])
  @@index([poemId])
}

enum MasteryLevel {
  NEW        // Just added, never practiced
  LEARNING   // Currently learning (0-3 correct reviews)
  YOUNG      // Recently learned (3-7 days interval)
  MATURE     // Well learned (7+ days interval)
  MASTERED   // Fully mastered (30+ days interval)
}

model UserMemorization {
  id              Int          @id @default(autoincrement())
  userId          Int
  poemId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  poem            Poem         @relation(fields: [poemId], references: [id], onDelete: Cascade)

  // Spaced Repetition Algorithm fields
  masteryLevel    MasteryLevel @default(NEW)
  easeFactor      Float        @default(2.5) // How "easy" the poem is (1.3 - 2.5+)
  interval        Int          @default(0)   // Days until next review
  repetitions     Int          @default(0)   // Number of successful reviews

  // Review tracking
  lastReviewedAt  DateTime?    // When last practiced
  nextReviewAt    DateTime?    // When to review next
  totalReviews    Int          @default(0)   // Total review attempts
  correctReviews  Int          @default(0)   // Successful reviews

  // Metadata
  notes           String?      // User's personal notes
  addedAt         DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, poemId])
  @@index([userId])
  @@index([poemId])
  @@index([nextReviewAt])
  @@index([masteryLevel])
}
